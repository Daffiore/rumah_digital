# ==========================================
# 1. Environment & Configuration Files
# ==========================================
# JANGAN PUSH KREDENSIAL / SETTINGAN LOKAL KE GITHUB!
/.env
/.env.backup
/.env.production
/.env.*.local
/.env.local

# ==========================================
# 2. Composer & Vendor Directories
# ==========================================
/vendor/

# ==========================================
# 3. Node & Frontend Packages (NPM/Vite)
# ==========================================
/node_modules/
/public/build/
/public/hot/
/public/storage
npm-debug.log
yarn-error.log
pnpm-debug.log

# ==========================================
# 4. Laravel Dynamic Files & Caches
# ==========================================
/bootstrap/app.php
/bootstrap/cache/*.php
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# ==========================================
# 5. Local Databases (SQLite & Dumps)
# ==========================================
*.sqlite
*.sqlite-journal
*.db
*.sql

# ==========================================
# 6. IDEs, Text Editors & OS Files
# ==========================================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# PhpStorm / JetBrains
.idea/

# Windows OS
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehqt.db
Desktop.ini
$RECYCLE.BIN/

# macOS OS
.DS_Store
.AppleDouble
.LSOverride

# Laragon / Local Server specific files
/storage/app/public/